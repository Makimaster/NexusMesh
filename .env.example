# .env.example — 复制为 .env 并填入真实值
# ⚠️ .env 永远不提交到版本控制

# ─── 应用 ────────────────────────────────────────
APP_NAME=NexusMesh
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
API_V1_PREFIX=/api/v1
LOG_LEVEL=DEBUG

# ─── 数据库 ──────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nexusmesh
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nexusmesh_db

# ─── Redis ───────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM 网关 ─────────────────────────────────────
LITELLM_API_BASE=
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_LLM_MODEL=gpt-4o

# ─── MinIO（Phase 3 启用）────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=nexusmesh

# ─── CORS ────────────────────────────────────────
# 支持逗号分隔多个源
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
